{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitra",
  "version": "1.1.0",
  "identifier": "com.susmi.mitra",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mitra",
        "width": 400,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Mitra Settings",
        "width": 470,
        "height": 550,
        "minWidth": 350,
        "minHeight": 450,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "shadow": true,
        "visible": false,
        "url": "index.html?page=settings"
      },
      {
        "label": "onboarding",
        "title": "Welcome to Mitra",
        "width": 800,
        "height": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "shadow": true,
        "visible": false,
        "url": "index.html?page=onboarding"
      },
      {
        "label": "tasks",
        "title": "Tasks & Goals",
        "width": 450,
        "height": 550,
        "minWidth": 350,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "shadow": true,
        "visible": false,
        "url": "index.html?page=tasks"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://ipapi.co https://*.open-meteo.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Susmita-Dey/mitra/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QjEwRkQ3RTA4N0M0Q0MKUldUTXhJZmcxdyt4bWU4QmJmcWtSTWFMelZDV3M5RmE5VlQrdk5uT255N01sVHNya05xNjc2YUkK"
    }
  }
}
