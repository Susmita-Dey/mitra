{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitra",
  "version": "0.1.0",
  "identifier": "com.susmi.mitra",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mitra",
        "width": 350,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "shadow": false,
        "visible": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Mitra Settings",
        "width": 400,
        "height": 550,
        "minWidth": 350,
        "minHeight": 450,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "shadow": true,
        "visible": false,
        "url": "/?page=settings"
      },
      {
        "label": "onboarding",
        "title": "Welcome to Mitra",
        "width": 600,
        "height": 450,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "shadow": true,
        "visible": false,
        "url": "/?page=onboarding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://ipapi.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
